<?xml version="1.0" encoding="utf-8"?>
<!-- Where the build downloads packages from (only Microsoft.NETFramework.ReferenceAssemblies).
     Listed here so the build works whatever NuGet sources are set up on the PC. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
